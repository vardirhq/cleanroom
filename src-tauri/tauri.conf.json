{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cleanroom",
  "version": "0.2.0",
  "identifier": "dev.madsens.cleanroom",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "closable": true,
        "decorations": false,
        "maximizable": true,
        "minimizable": true,
        "resizable": true,
        "title": "Cleanroom",
        "width": 1440,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/platform-tools/": "platform-tools/"
    }
  }
}
